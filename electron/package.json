{
  "name": "asia-front",
  "version": "1.0.0",
  "description": "亚洲战场 — 二战亚洲战场大战略（Windows 本地版）",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "fun.asiafront.game",
    "productName": "亚洲战场",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs"
    ],
    "extraResources": [
      {
        "from": "../game/dist",
        "to": "game"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "亚洲战场",
      "artifactName": "AsiaFront-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "AsiaFront-Portable-${version}.exe"
    }
  }
}